{
  "name": "revealgdb",
  "version": "0.1.0",
  "copyright": "© 2025",
  "private": true,
  "description": "A GDB debugger interface",
  "categories": [
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "Debugger",
    "GDB",
    "Graphical"
  ],
  "author": "Barry Nolte (barry@barrynolte.com)",
  "company": "Open Road Electronics, LLC",
  "maintainers": [
    "Barry Nolte (barry@barrynolte.com"
  ],
  "contributors": [],
  "homepage": "https://github.com/barrynolte/revealGDB",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "concurrently \"tsc -p tsconfig.main.json -w\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron . --remote-debugging-port=9222",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx,cjs}\" \"./vite.config.ts\"  --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md,cjs}\"",
    "format-build-tools": "prettier --write \"./vite.config.ts\"",
    "prepare": "husky install",
    "dist": "npm run build && electron-builder --publish never",
    "publish": "electron-builder --publish always",
    "endqemu": "wsl -e pkill qemu",
    "vite-build": "electron-vite build",
    "vite-watch": "electron-vite dev --watch"
  },
  "build": {
    "appId": "com.example.revealgdb",
    "productName": "revealGDB",
    "directories": {
      "output": "dist_electron",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      "assets/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null,
      "hardenedRuntime": true
    }
  },
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "electron": "^39.2.6",
    "electron-builder": "^24.13.3",
    "electron-vite": "^4.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^8.0.3",
    "lint-staged": "^16.2.7",
    "prettier": "3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@syncfusion/ej2-react-buttons": "^31.2.18",
    "@syncfusion/ej2-react-dropdowns": "^31.2.18",
    "@syncfusion/ej2-react-grids": "^31.2.18",
    "@syncfusion/ej2-react-inputs": "^31.2.15",
    "@syncfusion/ej2-react-navigations": "^31.2.16",
    "@syncfusion/ej2-react-popups": "^31.2.12",
    "@syncfusion/react-buttons": "^31.2.12",
    "ace-builds": "^1.43.5",
    "dock-spawn-ts": "^3.12.0",
    "electron-settings": "^4.0.4",
    "fontace": "^0.3.1",
    "get-system-fonts": "^2.0.2",
    "react": "^18.3.1",
    "react-ace": "^14.0.1",
    "react-dom": "^18.3.1"
  },
  "lint-staged": {
    "src/renderer/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/main/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/preload/**/*.{ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
