{
  "name": "revealgdb",
  "version": "0.9.1",
  "copyright": "© 2025",
  "license": "MIT",
  "private": true,
  "description": "A GDB debugger interface",
  "categories": [
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "Debugger",
    "GDB",
    "Graphical"
  ],
  "author": "Barry Nolte (barry@barrynolte.com)",
  "company": "Open Road Electronics, LLC",
  "maintainers": [
    "Barry Nolte (barry@barrynolte.com"
  ],
  "contributors": [],
  "homepage": "https://github.com/barrynolte/revealGDB",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "cross-env REVEALGDB_BUILD=debug REVEALGDB_DEBUG=true concurrently \"electron-vite build\" \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "vite build",
    "build:renderer:analyze": "cross-env REVEALGDB_ANALYZE_BUNDLE=true vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:release",
    "build:release": "cross-env REVEALGDB_BUILD=release REVEALGDB_DEBUG=false npm run build:renderer && npm run build:main",
    "build:debug": "cross-env REVEALGDB_BUILD=debug REVEALGDB_DEBUG=true npm run build:renderer && npm run build:main",
    "start": "electron . --remote-debugging-port=9222",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx,cjs}\" \"./vite.config.ts\"  --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md,cjs}\"",
    "format-build-tools": "prettier --write \"./vite.config.ts\"",
    "prepare": "husky",
    "dist": "npm run dist:release",
    "dist:release": "npm run build:release && electron-builder --publish never",
    "dist:debug": "npm run build:debug && electron-builder --publish never",
    "dist:all:release": "npm run build:release && electron-builder --publish never --mac --win --linux --x64 --arm64",
    "dist:all:debug": "npm run build:debug && electron-builder --publish never --mac --win --linux --x64 --arm64",
    "publish": "electron-builder --publish always",
    "endqemu": "wsl -e pkill qemu",
    "vite-build": "cross-env REVEALGDB_BUILD=debug REVEALGDB_DEBUG=true electron-vite build",
    "vite-build:release": "cross-env REVEALGDB_BUILD=release REVEALGDB_DEBUG=false electron-vite build",
    "vite-watch": "cross-env REVEALGDB_BUILD=debug REVEALGDB_DEBUG=true electron-vite dev --watch",
    "vite-watch:release": "cross-env REVEALGDB_BUILD=release REVEALGDB_DEBUG=false electron-vite dev --watch",
    "playwright:install": "playwright install",
    "metrics:maintainability": "node scripts/maintainability-metrics.cjs",
    "coverage:clean": "node scripts/coverage-report.cjs --clean",
    "coverage:report": "node scripts/coverage-report.cjs",
    "benchmark:startup": "node scripts/startup-benchmark.cjs",
    "benchmark:startup:set-baseline": "node scripts/startup-benchmark.cjs --set-baseline",
    "docs:api": "typedoc --options typedoc.json",
    "docs": "npm run docs:api",
    "test:playwright": "npm run build:renderer && playwright test",
    "build:renderer:coverage": "cross-env REVEALGDB_COVERAGE=true VITE_COVERAGE=true vite build",
    "test:coverage:vitest": "vitest run --coverage",
    "test:playwright:coverage": "npm run build:renderer:coverage && cross-env PLAYWRIGHT_COLLECT_COVERAGE=true playwright test",
    "test:coverage": "npm run coverage:clean && npm run test:coverage:vitest && npm run test:playwright:coverage && npm run coverage:report",
    "test": "vitest && npm run test:playwright"
  },
  "build": {
    "appId": "com.example.revealgdb",
    "productName": "revealGDB",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist_electron",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      "assets/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null,
      "hardenedRuntime": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-istanbul": "^4.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.3.1",
    "prettier": "3.8.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.2",
    "vite": "^7.3.1",
    "vite-plugin-istanbul": "^8.0.0",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@syncfusion/ej2-react-buttons": "^33.1.44",
    "@syncfusion/ej2-react-dropdowns": "^33.1.46",
    "@syncfusion/ej2-react-grids": "^33.1.46",
    "@syncfusion/ej2-react-inputs": "^33.1.44",
    "@syncfusion/ej2-react-navigations": "^33.1.46",
    "@syncfusion/ej2-react-popups": "^33.1.44",
    "@syncfusion/ej2-react-progressbar": "^33.1.44",
    "@syncfusion/ej2-react-splitbuttons": "^33.1.44",
    "@syncfusion/ej2-react-treegrid": "^33.1.46",
    "@syncfusion/react-buttons": "^33.1.44",
    "ace-builds": "^1.43.6",
    "dock-spawn-ts": "3.13.1",
    "electron-settings": "^4.0.4",
    "fontace": "^0.4.1",
    "get-system-fonts": "^2.0.2",
    "react": "^19.2.4",
    "react-ace": "^14.0.1",
    "react-dom": "^19.2.4"
  },
  "lint-staged": {
    "src/renderer/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/main/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/preload/**/*.{ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
